{
  "name": "costpilot-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*"
  ],
  "bin": {
    "costpilot-mcp": "./bin/costpilot-mcp.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "node scripts/dev-api-and-mcp.mjs",
    "dev:api:http": "npm --prefix apps/api run dev",
    "dev:api:mcp": "npm --prefix apps/api run dev:mcp",
    "mcp:client": "node ./bin/costpilot-mcp.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
