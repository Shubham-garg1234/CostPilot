NODE_ENV="development"
AUTH_MODE="clerk"
POSTGRES_MODE="required"
# optional: API starts with in-memory Redis / without ClickHouse when unreachable
REDIS_MODE="optional"
CLICKHOUSE_MODE="optional"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/costpilot"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/costpilot"
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USERNAME="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DATABASE="costpilot"
# HTTP timeout for ping, schema init, and inserts (ms). Increase for slow or cold-hosted ClickHouse.
CLICKHOUSE_REQUEST_TIMEOUT_MS="30000"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"
CLERK_JWT_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_AUTHORIZED_PARTIES="http://localhost:3000,http://localhost:4000"
OPENAI_API_KEY=""
PROMPT_ENHANCEMENT_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
LLM_PROVIDER_API_KEY="provider_placeholder"
SLACK_WEBHOOK_URL=""
EMAIL_FROM="alerts@example.com"
MAIL_PROVIDER="internal"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_SECURE="false"
BREVO_SMTP_USER=""
BREVO_SMTP_PASS=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
COSTPILOT_API_URL="http://127.0.0.1:4000"
COSTPILOT_EMPLOYEE_EMAIL=""
COSTPILOT_EMPLOYEE_PASSWORD=""
